# =============================================================================
# xnft-monitor environment variables
# =============================================================================
# Copy this file to .env and fill in only the values you want to use.
# .env is in .gitignore — never commit real tokens.
#
# PERMISSIONS MATTER
# ------------------
# xnft-monitor.sh *sources* this file, i.e. its contents run as shell code with
# the script's privileges (root under the systemd unit).  The script therefore
# refuses to read it unless it is owned by root or by the invoking user AND is
# not group/world-writable.  Create it tightly:
#
#   umask 077 && cp .env.example .env    # → 0600
#   chmod 600 .env                       # if it already exists
#   sudo chown root:root .env            # for the root systemd unit
#
# The unit itself prefers /etc/xnft-monitor.env (EnvironmentFile=), which
# systemd parses as plain KEY=VALUE and never executes as shell. That is the
# safer place for tokens on a server; this .env is for ad-hoc/cron use.
#
# Every value below is EMPTY on purpose: a channel whose variable is empty is
# skipped, so a fresh copy of this file sends nothing anywhere until you fill
# it in.  (Placeholder URLs would make the first run POST to dummy endpoints.)
# =============================================================================

# --- Slack -------------------------------------------------------------------
# Create an incoming webhook at: https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/xxxxxxxx
SLACK_WEBHOOK_URL=

# --- Discord -----------------------------------------------------------------
# Create a webhook in channel settings → Integrations → Webhooks
# Example: https://discord.com/api/webhooks/000000000000/xxxxxxxx
DISCORD_WEBHOOK_URL=

# --- Email -------------------------------------------------------------------
# Requires the 'mail' command (mailutils / s-nail). For cloud/VPS with no MTA,
# use ssmtp or msmtp pointing to an SMTP relay.
NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=

# --- Notion ------------------------------------------------------------------
# 1. Create a Notion integration at https://www.notion.so/my-integrations
# 2. Share a database page with the integration
# 3. Copy the integration token and database ID (from the page URL)
# The token is passed to curl on stdin (curl --config -), never on the command
# line, so it does not show up in /proc/<pid>/cmdline or in `ps auxww`.
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# --- NVD ---------------------------------------------------------------------
# Optional. Without a key NVD allows ~5 requests / 30 s and answers throttled
# requests with HTML; with a key the monitor gets a much higher quota.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- General -----------------------------------------------------------------
# GitHub repo for links in notifications
GITHUB_REPO=paulfxyz/xnftables

# Default notification channel: slack | discord | email | notion | all | none
# The --notify <channel> flag overrides this.
NOTIFY_CHANNEL=all

# Where to keep the findings JSON and .last-seen-versions.
# Unset → historical layout (findings in /tmp, state next to the script).
# The systemd unit sets this to /var/lib/xnft-monitor (StateDirectory=, 0700),
# which avoids root writing to predictable, world-writable /tmp paths.
# XNFT_STATE_DIR=/var/lib/xnft-monitor

# Set to 1 to run all checks without sending any notifications (testing).
# The --dry-run flag does the same thing and wins over this value — useful
# because .env is sourced before the command line is parsed.
DRY_RUN=0
